# Copy to .env.local (scripts/setup.sh does this for you).

# Data source: "mock" (demo data, no Google account needed) or "google" (live GBP APIs)
GBP_DATA_SOURCE=mock

# SQLite for dev. Use a postgres:// URL in production (and change provider in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
