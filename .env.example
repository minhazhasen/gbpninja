# Copy to .env.local (scripts/setup.sh does this for you).

# Data source: "mock" (demo data, no Google account needed) or "google" (live GBP APIs)
GBP_DATA_SOURCE=mock

# SQLite for dev. Use a postgres:// URL in production (and change provider in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Social networks (optional — demo mode simulates them). One OAuth app per network.
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Platform admins (comma-separated sign-in emails) — they can open /admin.
PLATFORM_ADMIN_EMAILS=

# Protects /api/cron/* (send "Authorization: Bearer <secret>"). Call /api/cron/refresh-competitors once a day. Required in production.
CRON_SECRET=

# Firebase Authentication (Login with Google). Web config from Firebase console → Project settings → Your apps.
# Enable Google under Authentication → Sign-in method, and add your domain under Authentication → Settings → Authorized domains.
# When these are set, every app page needs sign-in (/login). Leave empty to run the open demo.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Signs the session cookie (generate with: openssl rand -base64 32). Required when Firebase is set.
SESSION_SECRET=

# Google OAuth client (Cloud Console → APIs & Services → Credentials, type "Web application") — connects Gmail (gmail.send)
# and Google Business Profile (business.manage). Add GOOGLE_REDIRECT_URI to the client's Authorized redirect URIs.
# Enable the Gmail API and the Business Profile APIs (Account Management, Business Information) in the same Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/
# Facebook Login for Business configuration id (Meta app → Facebook Login for Business → Configurations).
META_LOGIN_CONFIG_ID=
# Where Facebook sends people back after signing in (add it to Facebook Login for Business → Valid OAuth Redirect URIs).
META_REDIRECT_URI=http://localhost:3001/api/oauth/meta/callback
# The app's public address. Instagram fetches post images from APP_URL/api/media/… — must be public (not localhost) to publish to Instagram.
APP_URL=http://localhost:3001
