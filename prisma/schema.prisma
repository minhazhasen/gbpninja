// SQLite for local/cloud dev. Switch provider to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
  // Schema + local tooling only (db push, studio, schema.sql). At runtime the app talks to SQLite through node:sqlite (src/lib/db.ts).
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Posts queued in the content calendar. The GBP API has no native scheduling,
// so a cron job publishes rows whose scheduledFor has passed.
model ScheduledPost {
  id           String   @id @default(cuid())
  locationId   String
  type         String   // STANDARD | EVENT | OFFER
  summary      String
  ctaType      String?
  ctaUrl       String?
  mediaUrl     String?
  scheduledFor DateTime
  status       String   @default("SCHEDULED") // DRAFT | SCHEDULED | PUBLISHED | FAILED
  googlePostId String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, scheduledFor])
}

// Reusable review reply templates, e.g. per star rating.
model ReplyTemplate {
  id        String   @id @default(cuid())
  name      String
  minRating Int      @default(1)
  maxRating Int      @default(5)
  body      String
  createdAt DateTime @default(now())
}

// History of profile audits, for score trends over time.
model AuditSnapshot {
  id         String   @id @default(cuid())
  locationId String
  score      Int
  issues     String   // JSON-encoded AuditIssue[]
  createdAt  DateTime @default(now())

  @@index([locationId, createdAt])
}

// Google accounts connected through OAuth (src/lib/google/oauth.ts), one per purpose: "gbp" (business.manage) or "gmail" (gmail.send).
// Tokens are AES-256-GCM encrypted with a key derived from SESSION_SECRET.
model GoogleToken {
  purpose      String   @id
  email        String
  name         String?
  scope        String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// The workspace's own data (tasks, templates, team, review requests, competitors, posts, connections, platform admin…) as JSON
// documents, one per key (src/lib/gbp/persist.ts). Google data is fetched live and only cached here.
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
